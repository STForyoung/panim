{
  "expo": {
    "name": "panim",
    "slug": "panim",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "panim",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
