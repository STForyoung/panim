{
  "expo": {
    "name": "Panim",
    "slug": "panim",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "panim",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.panim",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#2F6B62"
      },
      "package": "app.panim"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#F5F4F0",
          "android": {
            "image": "./assets/splash-android.png"
          }
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "831b6586-6747-48a0-ae48-a9b0d51940b0"
      }
    }
  }
}
